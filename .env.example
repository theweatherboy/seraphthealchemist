# Copy to .env.local and fill in the DEVELOPMENT Supabase project's public settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local development and local production-build testing:
SITE_URL=http://localhost:3000
# On Vercel previews, omit SITE_URL to use VERCEL_URL and allow that exact callback
# in Supabase. Production uses https://www.seraphthealchemist.com by default.
# Google OAuth's client secret stays in Supabase, not in this file.
